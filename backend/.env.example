# LendSure backend configuration — copy to .env and fill in. NEVER commit .env.
# OTP / SMS delivery
# Production: keep demo mode off and provide a Twilio Verify service.
# Local-only demo: set LENDSURE_DEMO_OTP=1 (never use that in production).
LENDSURE_DEMO_OTP=0
LENDSURE_OTP_TTL_MIN=5
LENDSURE_OTP_LEN=6
LENDSURE_SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Session security: sliding inactivity timeout in seconds (default 300 = 5 min).
# Every login gets an independent timer, refreshed by authenticated activity.
LENDSURE_IDLE_TIMEOUT_SEC=300
# AI Recovery Intelligence (Groq primary; switch with LLM_PROVIDER).
# Supported: groq | cerebras | gemini | deepseek (all OpenAI-compatible).
# DeepSeek: LLM_PROVIDER=deepseek, LLM_MODEL=deepseek-chat (default, tool-capable),
# LLM_API_KEY=sk-... from https://platform.deepseek.com/api_keys
# The key lives ONLY here, server-side — it is never sent to the browser.
# Without it the assistant answers 503 (no mock replies, ever).
LLM_PROVIDER=groq
LLM_MODEL=
LLM_API_KEY=
# OTP codes print to server logs ONLY when demo mode AND this flag are both on.
# Production default: off. Never enable in production.
# LENDSURE_LOG_CODES=1
# CORS: comma-separated allowed origins (no "*" in production)
LENDSURE_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:5173
# Max JSON body size in bytes
LENDSURE_MAX_BODY_BYTES=1000000
# External providers (all called server-side only; keys never reach the browser)
# Live market prices need NO key (Yahoo Finance, auto-refresh every 15 min).
# Live headlines need a free NewsAPI.org key (https://newsapi.org/register —
# free tier: 100 req/day). Without it, realistic seeded data is used.
NEWS_API_KEY=
# Gmail OTP delivery: your Gmail address + an App Password
# (Google Account → Security → 2-Step Verification → App passwords).
# Never use your real Gmail password here. Leave empty for demo mode
# (codes are shown on screen instead of emailed).
LENDSURE_SMTP_USER=
LENDSURE_SMTP_APP_PASSWORD=
